  ],
  [
   "swim",
   "Then in 1987, Lynne Cox swam across in about two hours, through near-freezing water."
  ],
  [
   "toast",
   "Months later, Reagan and Gorbachev raised a toast to her."
  ],
  [
   "end",
   "Four kilometers, and twenty-one hours. That's the map answer."
  ]
