  [
   "hook",
   "Fifty-four Minnesotans live where the only road runs through Canada."
  ],
  [
   "angle",
   "This is the Northwest Angle, north of the forty-ninth parallel."
  ],
  [
   "blame",
   "Blame a bad map."
  ],
  [
   "treaty",
   "In 1783, a treaty ran the border west from the Lake of the Woods to the Mississippi."
  ],
  [
   "wrong",
   "But the map was wrong, and that line never reaches the river."
  ],
  [
   "fix",
   "So in 1818, they used the forty-ninth parallel instead."
  ],
  [
   "corner",
   "But the line started at the lake's northwest corner, which sits above it."
  ],
  [
   "stay",
   "So that corner stayed American, cut off from Minnesota by water."
  ],
  [
   "end",
   "One wrong map gave Minnesota a corner with no road home."
  ]
 ],
