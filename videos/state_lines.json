 "lines": [
  [
   "hook",
   "Look at the eastern United States. Its borders twist along rivers and mountains."
  ],
  [
   "west",
   "Now look west. Straight lines."
  ],
  [
   "tease",
   "They were drawn on paper before the land was surveyed. And they're not really straight."
  ],
  [
   "east",
   "Eastern borders came from old colonies, following coasts and rivers."
  ],
  [
   "congress",
   "Out west, Congress drew borders from far away."
  ],
  [
   "law",
   "The easiest line to write into law? Latitude and longitude."
  ],
  [
   "twist",
   "But here's the twist: Colorado was meant to be a perfect box.",
   "But here's the twist. Colorado was meant to be a perfect box."
  ],
  [
   "survey",
   "Surveyors marked it by hand in the 1800s, and their mistakes gave it nearly seven hundred sides.",
   "Surveyors marked it by hand in the eighteen hundreds, and their mistakes gave it nearly seven hundred sides."
  ],
  [
   "court",
   "In 1925, the Supreme Court ruled the markers win.",
   "In nineteen twenty-five, the Supreme Court ruled the markers win."
  ],
  [
   "twist2",
   "And twist number two: Oklahoma's panhandle."
  ],
  [
   "texas",
   "Texas gave up its land north of the line Congress used to split slave and free territory."
  ],
  [
   "strip",
   "The leftover strip became the panhandle."
  ],
  [
   "end",
   "Which state has the weirdest border? Follow for more map stories."
  ]
